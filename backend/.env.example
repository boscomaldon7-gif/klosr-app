# Required — Claude API key. Used by every endpoint that hits Claude.
# Get it from https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Apollo (apollo.io) — powers /api/find-email (email + contact lookup).
# Without this, find-email returns 402. Apollo charges 1 email credit per
# successful reveal; the free tier includes a modest monthly allowance.
# Get a key at https://app.apollo.io/#/settings/integrations/api
APOLLO_API_KEY=

# SerpApi — live Google search. Powers (a) web research on briefs + chat, and
# (b) ICP lead discovery via /api/leads-discover (site:linkedin.com/in/ dorks).
# Without this, briefs generate with no fresh web signals AND the "Your leads"
# tab returns empty.
# https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Proxycurl (nubela.co) — powers /api/ninjapear for company/person enrichment.
# NOTE: Proxycurl's search endpoint shut down in 2025 and its successor
# (NinjaPear) only offers enrichment, not search — so lead discovery runs
# through SerpApi (above), not this key. This key is only for enrichment.
# https://nubela.co/dashboard/api/#keys
# Either name works; PROXYCURL_API_KEY takes precedence if both set.
PROXYCURL_API_KEY=
NINJAPEAR_API_KEY=

# Optional — default model override. Defaults to claude-opus-4-7.
CLAUDE_MODEL=claude-opus-4-7

# Deepgram — powers Live Call Assist real-time transcription.
# Get it at https://console.deepgram.com/signup (free $200 credit).
# Without this, the in-call Live Assist feature is disabled.
DEEPGRAM_API_KEY=

# ─── Admin panel + telemetry (Upstash Redis) ───
# The admin dashboard at /admin.html tracks installs, events, and per-user
# usage stats. Requires two Upstash Redis env vars + an admin password.
#
# Setup (5 minutes):
#   1. Go to https://upstash.com/ → create a free account (no credit card)
#   2. Create a new Redis database (pick any region close to Vercel)
#   3. From the database's "REST API" section, copy the REST URL + Token
#   4. Paste below, set ADMIN_PASSWORD to something long
# Free tier: 10,000 commands/day + 256MB — enough for ~500 daily active users.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Password required to log in at /admin.html. Keep this out of source.
ADMIN_PASSWORD=
